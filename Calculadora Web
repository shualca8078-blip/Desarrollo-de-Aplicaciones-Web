<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Calculadora Web</title>

<style>
    body{
        display:flex;
        justify-content:center;
        align-items:center;
        height:100vh;
        background:#1e1e1e;
        font-family:Arial, sans-serif;
    }

    .calculadora{
        background:#2c2c2c;
        padding:20px;
        border-radius:15px;
        width:300px;
        box-shadow:0 0 15px rgba(0,0,0,0.5);
    }

    #pantalla{
        width:100%;
        height:60px;
        font-size:2rem;
        text-align:right;
        margin-bottom:15px;
        border:none;
        border-radius:10px;
        padding-right:10px;
        box-sizing:border-box;
    }

    .botones{
        display:grid;
        grid-template-columns:repeat(4,1fr);
        gap:10px;
    }

    button{
        height:60px;
        font-size:1.5rem;
        border:none;
        border-radius:10px;
        cursor:pointer;
        background:#444;
        color:white;
        transition:0.2s;
    }

    button:hover{
        background:#666;
    }

    .igual{
        background:orange;
        grid-row:span 2;
    }

    .cero{
        grid-column:span 2;
    }
</style>
</head>

<body>

<div class="calculadora">
    <input type="text" id="pantalla" disabled>

    <div class="botones">
        <button onclick="limpiar()">C</button>
        <button onclick="agregar('/')">/</button>
        <button onclick="agregar('*')">*</button>
        <button onclick="borrar()">⌫</button>

        <button onclick="agregar('7')">7</button>
        <button onclick="agregar('8')">8</button>
        <button onclick="agregar('9')">9</button>
        <button onclick="agregar('-')">-</button>

        <button onclick="agregar('4')">4</button>
        <button onclick="agregar('5')">5</button>
        <button onclick="agregar('6')">6</button>
        <button onclick="agregar('+')">+</button>

        <button onclick="agregar('1')">1</button>
        <button onclick="agregar('2')">2</button>
        <button onclick="agregar('3')">3</button>
        <button class="igual" onclick="calcular()">=</button>

        <button class="cero" onclick="agregar('0')">0</button>
        <button onclick="agregar('.')">.</button>
    </div>
</div>

<script>
    const pantalla = document.getElementById("pantalla");

    function agregar(valor){
        pantalla.value += valor;
    }

    function limpiar(){
        pantalla.value = "";
    }

    function borrar(){
        pantalla.value = pantalla.value.slice(0, -1);
    }

    function calcular(){
        try{
            pantalla.value = eval(pantalla.value);
        }catch{
            pantalla.value = "Error";
        }
    }
</script>

</body>
</html>
